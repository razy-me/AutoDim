<Window x:Class="AutoDim.App.UI.ZonePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#55000000"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Cursor="Cross"
        KeyDown="OnWindowKeyDown"
        MouseLeftButtonDown="OnMouseDown"
        MouseMove="OnMouseMove"
        MouseLeftButtonUp="OnMouseUp"
        MouseRightButtonDown="OnRightClick">
    <Canvas x:Name="RootCanvas" ClipToBounds="True">
        <Border Canvas.Left="20" Canvas.Top="20"
                Background="#E6161820" BorderBrush="#334FA3FF" BorderThickness="1"
                CornerRadius="8" Padding="14,8">
            <TextBlock Text="Bereich mit linker Maustaste aufziehen  •  ESC oder Rechtsklick zum Abbrechen"
                       Foreground="#E6EAF2" FontSize="13" FontWeight="SemiBold"/>
        </Border>

        <Rectangle x:Name="SelectionRect"
                   Visibility="Collapsed"
                   Fill="#224FA3FF"
                   Stroke="#4FA3FF"
                   StrokeThickness="2"
                   StrokeDashArray="4 2"/>

        <Border x:Name="SizeBadge"
                Visibility="Collapsed"
                Background="#EE0D0E12"
                BorderBrush="#4FA3FF"
                BorderThickness="1"
                CornerRadius="4"
                Padding="8,4">
            <TextBlock x:Name="SizeBadgeText" Foreground="#E6EAF2" FontSize="12" FontFamily="Consolas"/>
        </Border>

        <Border x:Name="ConfirmPanel"
                Visibility="Collapsed"
                Background="#F2161820"
                BorderBrush="#4FA3FF"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Width="270">
            <StackPanel>
                <TextBlock Text="Neue statische Zone" Foreground="#E6EAF2" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                <TextBlock Text="Name" Foreground="#9AA3B5" FontSize="11" Margin="0,0,0,3"/>
                <TextBox x:Name="ZoneNameBox" Background="#0D0E12" Foreground="#E6EAF2" BorderBrush="#2C3140" Padding="6,4" Margin="0,0,0,8"/>
                <TextBlock Text="Prozessfilter (optional, z. B. code.exe)" Foreground="#9AA3B5" FontSize="11" Margin="0,0,0,3"/>
                <TextBox x:Name="ProcessFilterBox" Background="#0D0E12" Foreground="#E6EAF2" BorderBrush="#2C3140" Padding="6,4" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Abbrechen" Click="OnCancelSelectionClick" Padding="10,5" Margin="0,0,8,0"
                            Background="#242834" Foreground="#E6EAF2" BorderThickness="0"/>
                    <Button Content="Speichern" Click="OnSaveSelectionClick" Padding="12,5" IsDefault="True"
                            Background="#4FA3FF" Foreground="#0D0E12" FontWeight="SemiBold" BorderThickness="0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Canvas>
</Window>
