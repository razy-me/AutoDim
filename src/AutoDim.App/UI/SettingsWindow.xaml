<Window x:Class="AutoDim.App.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoDim — Einstellungen"
        Width="660" Height="640"
        MinWidth="580" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#0D0E12"
        Foreground="#E6EAF2">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E6EAF2"/>
        </Style>
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9AA3B5"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#161820"/>
            <Setter Property="BorderBrush" Value="#262936"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E6EAF2"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#242834"/>
            <Setter Property="Foreground" Value="#E6EAF2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="AutoDim — AMOLED Dimming" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="Änderungen werden live übernommen und automatisch gespeichert." Style="{StaticResource MutedText}"/>
        </StackPanel>

        <TabControl Grid.Row="1" Background="#0D0E12" BorderBrush="#262936">
            <TabItem Header="Timer &amp; Helligkeit">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <StackPanel>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Abdunklung (Deckkraft)" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="210"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="52"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Inaktive Fenster"/>
                                    <Slider x:Name="InactiveOpacitySlider" Grid.Column="1" Minimum="0" Maximum="98" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnSettingChanged"/>
                                    <TextBlock x:Name="InactiveOpacityLabel" Grid.Column="2" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="210"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="52"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="DimTaskbarCheck" Content="Taskleiste abdunkeln" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                                    <Slider x:Name="TaskbarOpacitySlider" Grid.Column="1" Minimum="0" Maximum="98" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnSettingChanged"/>
                                    <TextBlock x:Name="TaskbarOpacityLabel" Grid.Column="2" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="210"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="52"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Statische Zonen"/>
                                    <Slider x:Name="ZoneOpacitySlider" Grid.Column="1" Minimum="0" Maximum="98" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnSettingChanged"/>
                                    <TextBlock x:Name="ZoneOpacityLabel" Grid.Column="2" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="210"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="52"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="DimDesktopCheck" Content="Desktop-Hintergrund" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                                    <Slider x:Name="DesktopOpacitySlider" Grid.Column="1" Minimum="0" Maximum="98" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnSettingChanged"/>
                                    <TextBlock x:Name="DesktopOpacityLabel" Grid.Column="2" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Verzögerungen &amp; Animation" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="210"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="62"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Hover-Aufhell-Verzögerung"/>
                                    <Slider x:Name="HoverEnterDelaySlider" Grid.Column="1" Minimum="0" Maximum="3000" TickFrequency="50" IsSnapToTickEnabled="True" ValueChanged="OnSettingChanged"/>
                                    <TextBlock x:Name="HoverEnterDelayLabel" Grid.Column="2" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="210"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="62"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Hover-Exit Timer"/>
                                    <Slider x:Name="HoverDelaySlider" Grid.Column="1" Minimum="0" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnSettingChanged"/>
                                    <TextBlock x:Name="HoverDelayLabel" Grid.Column="2" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="210"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="62"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Fokusverlust Timer"/>
                                    <Slider x:Name="UnfocusDelaySlider" Grid.Column="1" Minimum="0" Maximum="120" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnSettingChanged"/>
                                    <TextBlock x:Name="UnfocusDelayLabel" Grid.Column="2" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="210"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="62"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Fade-Out Dauer"/>
                                    <Slider x:Name="FadeOutSlider" Grid.Column="1" Minimum="0" Maximum="2000" TickFrequency="20" IsSnapToTickEnabled="True" ValueChanged="OnSettingChanged"/>
                                    <TextBlock x:Name="FadeOutLabel" Grid.Column="2" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="210"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="62"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Fade-In Dauer"/>
                                    <Slider x:Name="FadeInSlider" Grid.Column="1" Minimum="0" Maximum="1000" TickFrequency="20" IsSnapToTickEnabled="True" ValueChanged="OnSettingChanged"/>
                                    <TextBlock x:Name="FadeInLabel" Grid.Column="2" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="210"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="62"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Fenster-Rand-Einrückung" ToolTip="Schneidet schmale 1–7 px DWM-Schatten/Rahmen um helle Fenster sauber ab"/>
                                    <Slider x:Name="FrameInsetSlider" Grid.Column="1" Minimum="0" Maximum="16" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnSettingChanged"/>
                                    <TextBlock x:Name="FrameInsetLabel" Grid.Column="2" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Statische Zonen">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="+ Zone visuell auf Bildschirm wählen" Background="#4FA3FF" Foreground="#0D0E12" FontWeight="SemiBold" Click="OnAddZoneVisualClick"/>
                    </StackPanel>
                    <ListBox x:Name="ZonesList" Grid.Row="1" Background="#161820" BorderBrush="#262936" Foreground="#E6EAF2">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding Enabled}" Checked="OnZoneToggleChanged" Unchecked="OnZoneToggleChanged" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="Entfernen" Tag="{Binding Id}" Click="OnDeleteZoneClick" Margin="8,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <TabItem Header="Ausnahmen &amp; System">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <StackPanel>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Verhalten &amp; System" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                                <CheckBox x:Name="PauseFullscreenCheck" Content="Bei Vollbild-Apps / Videos automatisch pausieren" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                                <CheckBox x:Name="ExcludeCaptureCheck" Content="Overlay aus Screenshots &amp; Screen-Sharing ausblenden" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                                <CheckBox x:Name="AutostartCheck" Content="AutoDim mit Windows starten" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Pause-Hotkey" VerticalAlignment="Center"/>
                                    <TextBox x:Name="HotkeyBox" Grid.Column="1" Background="#0D0E12" Foreground="#E6EAF2" BorderBrush="#2C3140" Padding="6,4" Margin="0,0,8,0"/>
                                    <Button Grid.Column="2" Content="Übernehmen" Click="OnApplyHotkeyClick"/>
                                    <TextBlock x:Name="HotkeyStatusText" Grid.Column="3" VerticalAlignment="Center" Margin="10,0,0,0" Style="{StaticResource MutedText}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Ausgenommene Prozesse (nie abdunkeln)" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ProcessInputBox" Background="#0D0E12" Foreground="#E6EAF2" BorderBrush="#2C3140" Padding="6,4" Margin="0,0,8,0"
                                             ToolTip="z. B. vlc.exe oder mpv.exe"/>
                                    <Button Grid.Column="1" Content="Hinzufügen" Click="OnAddProcessClick"/>
                                </Grid>
                                <ListBox x:Name="ExcludedList" Height="150" Background="#0D0E12" BorderBrush="#262936" Foreground="#E6EAF2"/>
                                <Button Content="Ausgewählten Prozess entfernen" Click="OnRemoveProcessClick" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Button Content="Standardwerte" HorizontalAlignment="Left" Click="OnResetDefaultsClick"/>
            <Button Content="Schließen" HorizontalAlignment="Right" Background="#4FA3FF" Foreground="#0D0E12" FontWeight="SemiBold" Click="OnCloseClick"/>
        </Grid>
    </Grid>
</Window>
